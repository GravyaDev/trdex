# trdex — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# === App Mode ===
TRDEX_MODE=simulation
# TRDEX_MODE=live  # Only after simulation gate criteria are met
TRDEX_LOG_LEVEL=INFO

# === Database ===
# Use db:5432 when running inside Docker Compose; localhost:5432 for bare-metal dev.
DATABASE_URL=postgresql+asyncpg://trdex:trdex@db:5432/trdex

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === FastAPI ===
TRDEX_API_HOST=0.0.0.0
TRDEX_API_PORT=8000
TRDEX_API_KEY=
# TRDEX_API_KEY=your_secret_api_key_here  # Set to enable auth (leave empty = dev mode, no auth)
TRDEX_CONFIG_ENCRYPTION_KEY=
# Master key for at-rest encryption of runtime_config.credentials.
# Generate with: python -m trdex.services.credentials_crypto
# Leave empty in dev = credentials stored plaintext (WARNING log).
TRDEX_CORS_ORIGINS=
# TRDEX_CORS_ORIGINS=http://localhost:3000  # Comma-separated allowed origins

# === Exchange API Keys ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# For Ed25519 keys: set this to the path of the PEM private key file.
# If set, overrides BINANCE_API_SECRET. CCXT auto-detects Ed25519 vs HMAC.
# Generate with: openssl genpkey -algorithm Ed25519 -out ~/.ssh/binance_ed25519.pem
TRDEX_BINANCE_API_SECRET_FILE=                            # e.g. ~/.ssh/binance_testnet_ed25519.pem
TRDEX_BINANCE_TESTNET=true                                # true = testnet, false = production (REAL MONEY)

# === Market Data API Keys ===
TRDEX_COINGECKO_API_KEY=your_coingecko_demo_key_here
TRDEX_FOREX_API_KEY=your_exchangerate_api_key_here        # https://www.exchangerate-api.com — free tier
TRDEX_CRYPTOCOMPARE_API_KEY=your_key_here                 # https://cryptocompare.com — free tier
TRDEX_ALPHAVANTAGE_API_KEY=your_key_here                  # https://alphavantage.co — free tier
TRDEX_FREECRYPTOAPI_KEY=your_key_here                     # https://freecryptoapi.com — optional free tier

# === News Sources ===
TRDEX_STOCKDATA_API_KEY=your_key_here                     # https://stockdata.org — free tier
TRDEX_PERPLEXITY_API_KEY=                                 # https://perplexity.ai/settings/api — sonar search (~$0.005/call)

# === News Ingestion Scheduler ===
TRDEX_INGESTION_INTERVAL=300                              # seconds between news fetch cycles (default: 300)
TRDEX_INGESTION_SYMBOLS=BTC/USDT,ETH/USDT                # comma-separated symbols to track

# === AI / Vector DB ===
TRDEX_JINA_API_KEY=your_jina_api_key_here                 # https://jina.ai — free tier, 100 req/min
TRDEX_QDRANT_URL=http://qdrant:6333                       # use qdrant:6333 in Docker, localhost:6333 bare-metal

# === Telegram Signal Following ===
# Get API credentials at https://my.telegram.org
TRDEX_TELEGRAM_API_ID=0
TRDEX_TELEGRAM_API_HASH=
TRDEX_TELEGRAM_PHONE=+39xxxxxxxxxx
TRDEX_TELEGRAM_CHANNELS=@channel1,@channel2               # comma-separated channel usernames
TRDEX_TELEGRAM_SIGNAL_BUDGET=100.0                        # fixed budget per signal in USDT

# === Agent Auto-Scheduler ===
TRDEX_AGENT_SCHEDULER_ENABLED=false                       # set true to auto-run agent cycles
TRDEX_AGENT_SCHEDULER_INTERVAL=300                        # seconds between agent cycles (default: 300)
TRDEX_AGENT_SCHEDULER_SYMBOLS=BTC/USDT,ETH/USDT           # comma-separated symbols for auto agent runs
TRDEX_AGENT_SCHEDULER_ACTIVE_HOURS=                       # 'HH:MM-HH:MM' UTC window (empty = H24, e.g. 08:00-22:00)

# === Risk / Stop-Loss Monitor ===
TRDEX_SL_CHECK_INTERVAL=30.0                              # seconds between stop-loss checks (default: 30)
TRDEX_SL_POSITION_PCT=0.05                                # per-position stop-loss: close at -5% (default: 0.05)
TRDEX_SL_TAKE_PROFIT_PCT=0.10                             # per-position take-profit: close at +10% (default: 0.10)
TRDEX_SL_TRAILING_STOP_PCT=0.03                           # trailing stop: close if price retraces 3% from peak (default: 0.03)
TRDEX_SL_DAILY_DRAWDOWN_PCT=0.10                          # daily portfolio drawdown → kill switch (default: 0.10)

# === Portfolio Risk Limits ===
TRDEX_MAX_POSITION_PCT=0.02                               # max % of portfolio per trade (default: 0.02 = 2%)
TRDEX_RISK_PER_TRADE_PCT=0.001                            # equity lost if the stop is hit; size = risk / stop, capped by MAX_POSITION_PCT (default: 0.001)

# === Simulation Gate Criteria (required before switching to live) ===
TRDEX_GATE_MIN_DAYS=30                                    # minimum simulation days
TRDEX_GATE_MIN_SHARPE=1.0                                 # minimum Sharpe ratio (annualised)
TRDEX_GATE_MAX_DRAWDOWN=0.20                              # maximum allowed drawdown (0–1)
TRDEX_GATE_MIN_WIN_RATE=0.40                              # minimum win rate (0–1)

# === Dashboard Auth (GitHub OAuth via oauth2-proxy) ===
# Create a GitHub OAuth App at https://github.com/settings/developers
# with callback URL: https://trdex.gravya.it/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=                                   # GitHub OAuth App Client ID
OAUTH2_PROXY_CLIENT_SECRET=                               # GitHub OAuth App Client Secret (SECRET)
OAUTH2_PROXY_COOKIE_SECRET=                               # Random 32-char string: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH2_PROXY_EMAIL_DOMAIN=*                               # Restrict to email domain (e.g. gravya.it) or * for any
OAUTH2_PROXY_GITHUB_USER=                                 # Restrict to specific GitHub username (e.g. GravyaDev). Empty = any authenticated GitHub user
