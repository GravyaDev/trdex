# trdex — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# === Exchange API Keys ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# === Aggregator API Keys ===
COINGECKO_API_KEY=your_coingecko_demo_key_here
# CRYPTOCOMPARE_API_KEY=your_key_here

# === AI / Embeddings ===
TRDEX_JINA_API_KEY=your_jina_api_key_here   # https://jina.ai — free tier
TRDEX_QDRANT_URL=http://localhost:6333       # self-hosted via Docker

# === Database ===
DATABASE_URL=postgresql+asyncpg://trdex:trdex@localhost:5432/trdex

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === App Settings ===
TRDEX_MODE=simulation
# TRDEX_MODE=live  # Only after simulation gate criteria are met
TRDEX_LOG_LEVEL=INFO

# === FastAPI ===
TRDEX_API_HOST=0.0.0.0
TRDEX_API_PORT=8000
TRDEX_API_KEY=
# TRDEX_API_KEY=your_secret_api_key_here  # Set to enable auth
TRDEX_CORS_ORIGINS=
# TRDEX_CORS_ORIGINS=http://localhost:3000  # Comma-separated
