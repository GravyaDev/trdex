# trdex-llm — gitignore adattato al repo di progetto.
# NB: il .gitignore originale veniva dal repo base di Kloudify e
# ignorava pezzi di infrastruttura di progetto (CLAUDE.md, Task Board.md,
# Riferimenti/, .github/, .mcp.json, interi .claude/commands|hooks|agents|skills).
# Qui teniamo tracciati gli asset di progetto e ignoriamo solo
# runtime/volatili/secret.

# ═══════════════════════════════════════════════════════
# Personal / environment overrides
# ═══════════════════════════════════════════════════════
.antigravity/
CLAUDE.local.md

# ═══════════════════════════════════════════════════════
# Kloudify runtime state (per-session, volatile)
# Tenere tracciati:
#   .claude/commands/  .claude/hooks/  .claude/agents/
#   .claude/skills/    .claude/universal-rules.md
#   .claude/knowledge-base.md.template  .claude/command-index.md
# Ignorare solo lo state che cambia ad ogni sessione:
# ═══════════════════════════════════════════════════════
.claude/memory.md
.claude/session-timer.json
.claude/project-stack.md
.claude/project-structure.md
.claude/knowledge-base.md
.claude/settings.local.json
.claude/kloudify-version.json
.claude/logs/
.claude/agent-memory/
.claude/reports/
.claude/backups/
.claude/knowledge-nominations.md
.claude/.cozempic-init.lock
.claude/settings.*.bak

# Gossipcat runtime state
.gossip/

# ═══════════════════════════════════════════════════════
# Project workspace (per-user notes, non versionato)
# ═══════════════════════════════════════════════════════
Daily Notes/
Scratchpad.md
__NEEDS_ONBOARD

# ═══════════════════════════════════════════════════════
# Legacy design docs (non più versionati)
# ═══════════════════════════════════════════════════════
Riferimenti/

# ═══════════════════════════════════════════════════════
# Python
# ═══════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# ═══════════════════════════════════════════════════════
# Virtual environments
# ═══════════════════════════════════════════════════════
.venv/
venv/

# ═══════════════════════════════════════════════════════
# Environment & secrets
# ═══════════════════════════════════════════════════════
.env
*.pem
*.key
*.session

# ═══════════════════════════════════════════════════════
# IDE
# ═══════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo

# ═══════════════════════════════════════════════════════
# Testing & coverage
# ═══════════════════════════════════════════════════════
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ═══════════════════════════════════════════════════════
# Docker volumes (local data)
# ═══════════════════════════════════════════════════════
pgdata/

# ═══════════════════════════════════════════════════════
# Playwright MCP artefacts
# ═══════════════════════════════════════════════════════
.playwright-mcp/
dashboard-*.png
package.json
package-lock.json

# ═══════════════════════════════════════════════════════
# Telegram operational data (dumps, channel lists)
# ═══════════════════════════════════════════════════════
telegram_*_dump.json
telegram_channel_dump.json
channels_to_join.txt
channels_failed_lookup.md

# ═══════════════════════════════════════════════════════
# Emergent reports + stray composer dir
# ═══════════════════════════════════════════════════════
docs/Report TrdeX LLM di Emergent.md
trdex composer/

# Backtest OHLCV cache (regenerable from Binance, ~50MB)
scripts/data/ohlcv_5y/
scripts/data/backtest_results_*.csv
